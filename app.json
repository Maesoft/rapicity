{
  "expo": {
    "name": "RapiCity",
    "slug": "RapiCity",
    "version": "0.0.1",
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "experiments": {
      "tsconfigPaths": true
    },
    "plugins": [
      "expo-router",
      "expo-font"
    ],
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#005F73"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.maesoft.rapicity",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#005F73"
      }
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "23ac59e9-de84-49b3-ad2d-7fc1f3212413"
      }
    },
    "owner": "maesoft"
  }
}
